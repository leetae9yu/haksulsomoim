{
  "name": "@haksulsomoim/desktop",
  "version": "0.1.0",
  "description": "국내 계좌이체 소액사기 피해자를 위한 Windows 로컬 사건 코파일럿",
  "author": "Haksul Somoim",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "electron-vite build",
    "qa:desktop": "xvfb-run -a node scripts/qa-desktop.ts",
    "qa:privacy": "bun run scripts/qa-privacy.ts",
    "qa:korean-law-mcp": "bun run scripts/qa-korean-law-mcp.ts",
    "qa:agent-provider": "bun run scripts/qa-agent-provider.ts",
    "dist:win": "node scripts/package-windows.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.147.0",
    "@openclaw/fs-safe": "0.5.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "cfb": "1.2.2",
    "jszip": "3.10.1",
    "korean-law-mcp": "4.9.6",
    "markdown-it": "14.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@happy-dom/global-registrator": "20.11.2",
    "@playwright/test": "1.62.1",
    "@swc/core": "1.15.47",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3"
  }
}
