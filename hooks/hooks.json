{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$PLUGIN_ROOT\" && npm install --ignore-scripts --omit=dev --no-audit --no-fund",
            "statusMessage": "Preparing haksulsomoim plugin dependencies"
          }
        ]
      }
    ]
  }
}
