{
  "name": "haksulsomoim-small-fraud-agent",
  "version": "0.1.0",
  "description": "Claude Code and Codex plugin for Korean small-fraud evidence and procedure support",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "bun test servers scripts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "bun run scripts/build-plugin.ts",
    "install:local": "bun run build && bun run scripts/install-local.ts",
    "mcp": "bun run servers/index.ts",
    "validate:plugin": "bun run build && bun run scripts/validate-plugin.ts plugin",
    "qa:mcp": "bun run scripts/qa-mcp.ts",
    "qa:installed": "bun run scripts/qa-installed-mcp.ts",
    "qa:law": "bun run scripts/qa-law.ts",
    "qa:court": "bun run scripts/qa-court-portal.ts",
    "qa:court-mock": "bun run scripts/qa-court-style-mock.ts",
    "qa:ocr": "bun run scripts/qa-ocr-redaction.ts",
    "qa:secure-computer": "bun run scripts/qa-secure-computer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "korean-law-mcp": "4.9.6",
    "playwright-core": "1.62.1",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
