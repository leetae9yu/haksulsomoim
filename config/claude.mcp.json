{
  "mcpServers": {
    "haksulsomoim-local": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/servers/index.js"],
      "env": {
        "HAKSUL_CASES_DIR": "${CLAUDE_PROJECT_DIR}/.haksulsomoim/cases"
      }
    },
    "korean-law": {
      "command": "npx",
      "args": ["--yes", "korean-law-mcp@4.9.6"],
      "env": {
        "LAW_OC": "${LAW_OC}"
      }
    }
  }
}
