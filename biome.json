{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "servers/**/*.ts",
      "scripts/**/*.ts",
      "skills/**/*.md",
      ".claude-plugin/**/*.json",
      ".codex-plugin/**/*.json",
      "config/**/*.json",
      "hooks/**/*.json",
      "*.json",
      "!!apps/desktop",
      "!!node_modules",
      "!!dist",
      "!!plugin",
      "!!260811",
      "!!.omo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
